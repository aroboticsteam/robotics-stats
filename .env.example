# --- Required -------------------------------------------------------------
# RobotEvents API token (https://www.robotevents.com/api/v2)
VEX_API_KEY=

# --- Teams (comma separated) ----------------------------------------------
TEAMS_VIQRC=
TEAMS_V5RC=
# Program shown at "/" : VIQRC or V5RC
DEFAULT_PROGRAM=VIQRC

# --- Branding -------------------------------------------------------------
SITE_TITLE=Robotics Stats
SITE_SUBTITLE=
# Logo: any URL, or /media/<file> from a mounted volume. Omit for no logo.
LOGO_URL=
LOGO_ALT=
LOGO_HREF=
LOGO_WHITE_BG=true
FAVICON_URL=
# Top-left "Home" button (hidden when HOME_URL is empty)
HOME_URL=
HOME_LABEL=Home
FOOTER_TEXT=
FOOTER_SECONDARY_TEXT=VEX Robotics Competition

# --- Theme: QE brand by default; every value is optional (6-digit hex) ---
# THEME_MODE=auto            # auto | dark | light
# THEME_BG=#000E23           # dark palette: BG BG2 CARD RAISE LINE INK MUTED ACCENT LINK OK RED BLUE
# THEME_LIGHT_BG=#F2F4F7     # light palette, same tokens
# IQ_COLOR=#0C7C9D
# V5_COLOR=#9A2339
# FONT_HEADING=Space Grotesk

# --- Behaviour ------------------------------------------------------------
AUTO_REFRESH_SECONDS=180
CACHE_FRESH_SECONDS=7200
CACHE_MAX_AGE_SECONDS=604800
CACHE_MAX_ENTRIES=2000
UPSTREAM_CONCURRENCY=4
# VEX_API_BASE_URL=https://events.vex.com/api/v2
# VEX_USER_AGENT=

# --- Server ---------------------------------------------------------------
PORT=8080
MEDIA_DIR=/media

# Optional shared cache for multiple replicas
# REDIS_URL=redis://redis:6379
# REDIS_PREFIX=robotics-stats:
